Bootstrap: docker
From: nvidia/cuda:12.8.0-cudnn-devel-ubuntu24.04

%labels
    Author kstarxin
    Version 1.0
    Description SurfacePrint CUDA environment for statistical and embedding baselines

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-venv \
        git \
        wget \
        curl \
        build-essential

    ln -sf /usr/bin/python3 /usr/bin/python

    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    uv pip install --system --break-system-packages setuptools wheel

    # PyTorch (CUDA 12.8)
    uv pip install --system --break-system-packages torch==2.10.0

    # Qwen3-Embedding training and evaluation use Flash Attention 3.
    uv pip install --system --break-system-packages --no-build-isolation \
        https://github.com/mjun0812/flash-attention-prebuild-wheels/releases/download/v0.8.2/flash_attn_3-3.0.0+cu128torch2.10gite2743ab-cp39-abi3-manylinux_2_24_x86_64.manylinux_2_28_x86_64.whl

    uv pip install --system --break-system-packages \
        "transformers>=5.5.0,<5.6.0" \
        datasets \
        accelerate \
        safetensors \
        scikit-learn \
        numpy \
        tqdm

    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    uv cache clean

%environment
    export CUDA_DEVICE_ORDER=PCI_BUS_ID
    export PATH="/root/.local/bin:$PATH"

%runscript
    exec python "$@"

%help
    SurfacePrint: Typographic Fingerprints of LLMs.

    CUDA environment for:
      - Statistical baselines (scripts/statistical/*.sh)
      - Embedding detector training and evaluation (train_bert_*.py, eval_bert_*.py)

    SurfacePrint feature extraction and random forests run on CPU.

    Usage:
        apptainer run surfaceprint.sif <script.py> [args...]
        apptainer exec --nv surfaceprint.sif python run_baseline_statistical.py --help
